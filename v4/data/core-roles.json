                    const p2 = pos[tx.to] || pos["@proyecto"];
                    return `<div style="position:absolute; left:${(p1.x + p2.x) / 2}px; top:${(p1.y + p2.y) / 2}px; 
                                 background:#1e293b; border:1px solid #3b82f6; color:white; padding:4px 8px; border-radius:4px; 
                                 font-size:0.65rem; transform:translate(-50%, -50%); z-index:10; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                                <div style="color:#3b82f6; font-weight:bold;">${tx.concepto}</div>
                                <div style="font-size:0.55rem; color:#94a3b8;">${tx.liquidación}€</div>
                            </div>`;
                }).join('')}
            </div>
        `;
    }
};

