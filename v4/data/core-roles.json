<body>

    <div class="header">
        <h1>🛡️ SOS v4: Protocolo de Integración</h1>
        <p>Verificación de Kernel, Ontología FEVS y Motor de Liquidación</p>
    </div>

    <div id="status-report">
        <p class="loading">⚙️ Iniciando secuencia de verificación y cargando ontología...</p>
    </div>

    <script type="module">
        import { store } from '../js/core/store.js';
        import { Selectors } from '../js/core/selectors.js';

        const report = document.getElementById('status-report');

        /**
         * Renderiza el resultado de un test en el DOM
         */
        function renderTestResult(name, condition, errorMsg = "", debugData = null) {
            const div = document.createElement('div');
            div.className = 'test-unit ' + (condition ? 'success' : 'error');
            
            div.innerHTML = `
                <span class="test-title">
                    <span class="status-tag">${condition ? 'PASS' : 'FAIL'}</span>
                    ${name}
                </span>
                <div class="test-result">
                    ${condition ? 'La verificación ha sido exitosa.' : 'Se ha detectado una anomalía en el sistema.'}
                </div>
                ${!condition ? `<div class="log"><strong>ERROR:</strong> ${errorMsg}</div>` : ''}
                ${debugData ? `<div class="log"><strong>DEBUG:</strong> ${JSON.stringify(debugData, null, 2)}</div>` : ''}
            `;
            report.appendChild(div);
        }

        /**
         * Suite de Pruebas Asíncrona
         */
        async function runSuite() {
            // 1. Esperar a que el Kernel cargue el JSON y LocalStorage
            await store.initPromise;
            report.innerHTML = ''; // Limpiar mensaje de carga

            // --- TEST 1: Integridad del Store ---
            const state = store.getState();
            const hasRoles = state.roles && state.roles.length > 0;
            renderTestResult("Estructura del Store SOS", hasRoles, "La ontología de roles no se cargó correctamente.");

            // --- TEST 2: Motor de Liquidación (El punto crítico) ---
            const testProjectId = 'p-verif-' + Date.now();
            
            // Creamos proyecto de prueba
            store.dispatch({ 
                type: 'ADD_PROJECT', 
                payload: { id: testProjectId, nombre: 'Certificación v4' } 
            });

            // Añadimos transacción de 2h de Anxaneta (90€ * 3.0 * 2h = 540€)
            store.dispatch({ 
                type: 'ADD_TRANSACTION', 
                payload: { 
                    projectId: testProjectId, 
                    transaction: { rolId: '@anxaneta', horas: 2, concepto: 'Auditoría de Kernel' } 
                } 
            });

            // Esperamos 150ms para asegurar que el Store ha procesado y guardado
            setTimeout(() => {
                const updatedState = store.getState();
                const project = updatedState.projects.find(p => p.id === testProjectId);
                const tx = project ? project.transactions[0] : null;
                
                if (!tx) {
                    renderTestResult("Cálculo de Liquidación (Anxaneta x2h)", false, "No se registró la transacción.");
                    return;
                }

                const resultValue = tx.liquidación;
                const expectedValue = 540;
                const isCorrect = (resultValue === expectedValue);

                renderTestResult(
                    "Cálculo de Liquidación (Anxaneta x2h)", 
                    isCorrect, 
                    `Valor incorrecto: ${resultValue}€. Se esperaban ${expectedValue}€.`,
                    { rolUsado: tx.rolId, liquidacion: resultValue, objetivo: expectedValue }
                );

                // --- TEST 3: Selectores VNA ---
                const health = Selectors.getProjectResilienceIndex(updatedState, testProjectId);
                const isVNAOk = health && health.ratio !== undefined;
                renderTestResult(
                    "Diagnóstico VNA (Resiliencia)", 
                    isVNAOk, 
                    "El motor VNA no pudo procesar los datos del proyecto.",
                    { statusVNA: health.status, ratio: health.ratio }
                );

                console.log("🏁 Protocolo de pruebas v4 finalizado.");
            }, 150);
        }

        // Ejecutar cuando el Store emita la señal de listo
        window.addEventListener('store-ready', runSuite);
    </script>
</body>
</html>

