import { store } from '../core/store.js';
import { Selectors } from '../core/selectors.js';
import { ValueMapView } from './ValueMapView.js';

export const ProjectView = {
    render: (projectId) => {
        const state = store.getState();
        const project = state.projects.find(p => p.id === projectId);
        
        if (!project) return `<h1>404: Castell no encontrado</h1>`;

        const health = Selectors.getProjectResilienceIndex(state, projectId);

        return `
            <div class="project-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <div>
                    <h1 style="margin:0;">🏗️ ${project.nombre}</h1>
                    <small style="color:#64748b;">ID: ${projectId}</small>
                </div>
                <div class="vna-badge" style="background:#1e293b; padding:10px 20px; border-radius:8px; border:1px solid #334155; text-align:right;">
                    <div style="font-size:0.7rem; color:#94a3b8;">RESILIENCIA VNA</div>
                    <div style="color:${health.status === 'robusto' ? '#4ade80' : '#f87171'}; font-weight:bold;">
                        ${health.status.toUpperCase()} (${(health.ratio * 100).toFixed(0)}%)
                    </div>
                </div>
            </div>

            <div class="main-layout" style="display:grid; grid-template-columns: 1fr 350px; gap:20px;">
                
                <section>
                    <div style="background:#1e293b; padding:20px; border-radius:12px;">
                        <h3 style="margin-top:0;">🌐 Mapa de Valor (Flujos en tiempo real)</h3>
                        ${ValueMapView.render(projectId)}
                    </div>

                    <div style="margin-top:20px; background:#1e293b; padding:20px; border-radius:12px;">
                        <h3>📝 Registro Manual (Pre-Parser)</h3>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                            <input id="input-concepto" placeholder="¿Qué se ha hecho?" style="grid-column: span 2; padding:10px; background:#0f172a; border:1px solid #334155; color:white; border-radius:4px;">
                            <select id="input-rol" style="padding:10px; background:#0f172a; border:1px solid #334155; color:white; border-radius:4px;">
                                ${state.roles.map(r => `<option value="${r.id}">${r.nombre}</option>`).join('')}
                            </select>
                            <input id="input-horas" type="number" placeholder="Horas" value="1" style="padding:10px; background:#0f172a; border:1px solid #334155; color:white; border-radius:4px;">
                            <button onclick="window.registrarValor('${projectId}')" style="grid-column: span 2; padding:12px; background:#3b82f6; color:white; border:none; border-radius:4px; font-weight:bold; cursor:pointer;">
                                Inyectar al Castell
                            </button>
                        </div>
                    </div>
                </section>

                <aside style="background:#1e293b; padding:20px; border-radius:12px;">
                    <h3 style="margin-top:0;">💰 Liquidación SOS</h3>
                    <div id="tx-history" style="font-size:0.85rem;">
                        ${project.transactions.slice().reverse().map(tx => `
                            <div style="border-bottom:1px solid #334155; padding:10px 0;">
                                <div style="display:flex; justify-content:space-between;">
                                    <strong>${tx.rolId}</strong>
                                    <span>${tx.liquidación}€</span>
                                </div>
                                <div style="color:#94a3b8; font-size:0.75rem;">${tx.concepto}</div>
                            </div>
                        `).join('')}
                    </div>
                </aside>
            </div>
        `;
    }
};

2. El Contenedor Principal (v4/project.html)

Este archivo es el que abrirás en el navegador. Se encarga de capturar el ID de la URL (ej: project.html?id=p-123) y montar la vista.
HTML

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SOS v4 | Agile Canvas</title>
    <link rel="stylesheet" href="css/sos-style.css">
</head>
<body>
    <nav>
        <a href="index.html">← Volver al Dashboard</a>
    </nav>

    <div id="app"></div>

    <script type="module">
        import { store } from './js/core/store.js';
        import { ProjectView } from './js/views/ProjectView.js';

        // 1. Obtener ID del proyecto de la URL
        const params = new URLSearchParams(window.location.search);
        const projectId = params.get('id');

        // 2. Función global para que el botón de la vista funcione
        window.registrarValor = (pId) => {
            const concepto = document.getElementById('input-concepto').value;
            const rolId = document.getElementById('input-rol').value;
            const horas = parseFloat(document.getElementById('input-horas').value);

            if (!concepto) return alert("Describe el valor aportado");

            store.dispatch({
                type: 'ADD_TRANSACTION',
                payload: {
                    projectId: pId,
                    transaction: { rolId, horas, concepto, tipo_valor: 'tangible', categoria: '#hacer' }
                }
            });
            render(); // Refrescar vista
        };

        const render = () => {
            const app = document.getElementById('app');
            app.innerHTML = ProjectView.render(projectId);
        };

        // 3. Arrancar cuando el Store esté listo
        window.addEventListener('store-ready', render);
        store.subscribe(render); // Re-renderizar si el estado cambia
    </script>
</body>
</html>

