Sustituye el bloque del script por este:
HTML

<script type="module">
    import { store } from '../js/core/store.js';
    import { Selectors } from '../js/core/selectors.js';

    const report = document.getElementById('status-report');

    function createLog(name, condition, errorMsg = "") {
        const div = document.createElement('div');
        div.className = 'test-unit ' + (condition ? 'success' : 'error');
        div.innerHTML = (condition ? '✅ PASS: ' : '❌ FAIL: ') + name + 
                        (condition ? '' : `<div class="log">${errorMsg}</div>`);
        report.appendChild(div);
    }

    // Función principal de tests asíncronos
    async function runSuite() {
        report.innerHTML = '⚙️ Ejecutando suite de integración...';
        
        // 1. Esperar a que el Store esté realmente inicializado
        await store.initPromise;
        report.innerHTML = ''; 

        // --- TEST A ---
        const state = store.getState();
        createLog("Estructura del Store SOS", state.roles.length > 0);

        // --- TEST B: EL CRÍTICO ---
        const pId = 'p-test-gold-' + Date.now(); // ID único para evitar caché
        
        // Enviamos la acción
        store.dispatch({ type: 'ADD_PROJECT', payload: { id: pId, nombre: 'Test Integración' } });
        store.dispatch({ 
            type: 'ADD_TRANSACTION', 
            payload: { 
                projectId: pId, 
                transaction: { rolId: '@anxaneta', horas: 2, concepto: 'Test de Valor' } 
            } 
        });

        // Pequeña pausa para que el Store asiente los datos
        setTimeout(() => {
            const updatedState = store.getState();
            const project = updatedState.projects.find(p => p.id === pId);
            const tx = project.transactions[0];
            
            const isCorrect = tx.liquidación === 540;
            createLog(
                "Cálculo de Liquidación (Anxaneta x2h)", 
                isCorrect, 
                `Calculó ${tx.liquidación}€, se esperaban 540€. (Rol detectado: ${tx.rolId})`
            );

            // --- TEST C ---
            const health = Selectors.getProjectResilienceIndex(updatedState, pId);
            createLog("Diagnóstico VNA (Resiliencia)", health.ratio > 0);
            
            console.log("🏁 Suite completada. Resultado esperado: 540€. Resultado real:", tx.liquidación);
        }, 100); 
    }

    // Iniciar cuando el store avise
    window.addEventListener('store-ready', runSuite);
</script>

🧠 ¿Qué estaba pasando?

En tu versión anterior, el JS ejecutaba el createLog milisegundos después del dispatch. Como el dispatch de la v4 guarda en localStorage (que es una operación síncrona pero "pesada"), a veces el test leía el estado un instante antes de que se actualizara el objeto en memoria, o leía el ID del proyecto anterior que se quedó a medio borrar.

Con este cambio:

    Usamos un ID único (Date.now()) para que cada vez que refresques el test sea una prueba limpia.

    Usamos un setTimeout de 100ms. Es el tiempo justo para que el motor de JS termine de procesar la transacción y el test lea el dato real de 540€.

Prueba ahora. Si en la consola ya veías 540€, con este ajuste el "semáforo" del test se pondrá en verde por fin. ¡Es el último paso para irnos a dormir con la v4 blindada! 🏗️🚀
