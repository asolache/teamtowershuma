Cuando pulsas ese botón, se dispara esta función que incluimos en el script del Dashboard:
JavaScript

window.crearProyecto = () => {
    const name = document.getElementById('new-project-name').value;
    if (!name) return alert("Ponle un nombre al Castell");
    
    // Generamos un ID único basado en el tiempo
    const id = 'p-' + Date.now(); 

    // Enviamos la orden al Store (Kernel)
    store.dispatch({ 
        type: 'ADD_PROJECT', 
        payload: { id, nombre: name } 
    });

    // Limpiamos el input
    document.getElementById('new-project-name').value = "";
};

