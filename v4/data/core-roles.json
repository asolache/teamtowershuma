                                    <span style="font-size: 0.7rem; color: #94a3b8;">${tx.uv} UV</span>
                                    <span style="font-size: 0.75rem; color: #fff; font-weight: bold;">${tx.liquidación}€</span>
                                </div>

                                <div style="position: absolute; top: -10px; right: -10px; background: ${color}; color: #000; font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; font-weight: 900;">
                                    ${tx.categoria}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
    }
};

