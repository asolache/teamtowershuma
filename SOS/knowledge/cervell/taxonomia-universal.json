      "episodic": {
        "ca": "episòdica",
        "es": "episódica",
        "diu_es": "Lo que pasó: decisiones e informes, con fecha. No se reescribe."
      },
      "semantic": {
        "ca": "semàntica",
        "es": "semántica",
        "diu_es": "Lo que se sabe: visión, modelos y aprendizajes. Se mantiene al día."
      },
      "procedural": {
        "ca": "procedimental",
        "es": "procedimental",
        "diu_es": "Lo que se sabe hacer: procesos. Se mejora con cada uso."
      },
      "prospective": {
        "ca": "prospectiva",
        "es": "prospectiva",
        "diu_es": "Lo que se va a hacer: planes, propuestas y acuerdos. Caduca o se cumple."
